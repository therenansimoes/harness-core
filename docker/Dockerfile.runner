# docker/Dockerfile.runner — imagem mínima pra rodar VERIFY isolado.
#
# O agente (claude CLI) continua rodando FORA do container — só o workspace e
# o verify.py entram aqui quando `run_task.py --isolation docker` está ligado.
# Por isso não há claude CLI nem credenciais nesta imagem: ela só precisa dar
# conta do que as suites atuais (tasks/, benchmarks/sealed) executam dentro do
# workspace (python stdlib, unittest, subprocess). git/make/gcc/node ficam
# como piso mínimo para tasks futuras que compilem algo ou usem um Makefile —
# nenhuma suite hoje depende deles.
#
# Build: docker build -t harness-runner:latest -f docker/Dockerfile.runner .
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        make \
        gcc \
        curl \
        ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pytest

WORKDIR /ws
